GOOGLE_API_KEY=

GROQ_API_KEY=

# ---------------------------------------------------------------- FinOVA auth
# Base SQLite dediee (jamais la base DuckDB analytique)
BIFLOW_AUTH_DB=data/auth/auth.sqlite3
# Secret de signature des jetons d'acces. Vide = cle generee dans data/auth/jwt.key
BIFLOW_AUTH_SECRET=
# URL publique utilisee dans les liens d'invitation et de reinitialisation
BIFLOW_PUBLIC_URL=http://127.0.0.1:8000
BIFLOW_ACCESS_TOKEN_MINUTES=15
BIFLOW_REFRESH_DAYS=30
BIFLOW_INVITE_HOURS=168
BIFLOW_RESET_MINUTES=15
# Mettre 1 derriere HTTPS
BIFLOW_COOKIE_SECURE=0

# SMTP (si SMTP_HOST est vide, les emails sont ecrits dans data/auth/outbox/)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FinOVA <no-reply@finova.tn>
SMTP_STARTTLS=1
SMTP_SSL=0
